{
  "name": "forse-dess-monitor-telegram-notify",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone Telegram notifier for a Forse/DessMonitor inverter",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/server.cjs --log-level=warning",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file=.env dist/server.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
