# Copy to ".env" on the server and fill in. Never commit the real file.

# DessMonitor / Smart ESS account (the same one the desktop app uses).
DESS_USERNAME=
# Either the password itself, or its SHA-1 (the hash is safer to keep on disk).
DESS_PASSWORD=
DESS_PASSWORD_SHA1=

# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Family members subscribe by sending "/start <this code>" to the bot. Pick something not guessable.
JOIN_CODE=

# Optional (defaults in brackets).
# LANGUAGE=uk            # uk | en  (uk)
# POLL_SEC=60            # 30..600  (60); regular poll of the cloud data (statuses, faults)
# DIRECT_SEC=10          # 10..600, 0 = off  (10); fast direct reads of the inverter through the cloud
# DIRECT_UNIT=1          # Modbus address of the inverter (1)
# BATTERY_LOW_PCT=20     # (20)
# OVERLOAD_PCT=80        # (80)
# NOTIFY_GRID=true
# NOTIFY_BATTERY_LOW=true
# NOTIFY_OVERLOAD=true
# NOTIFY_FAULT=true
# NOTIFY_OFFLINE=true
# NOTIFY_CONNECTION=true
# ANNOUNCE_START=false   # send "service started" to everyone on every start
# DATA_DIR=./data        # where the subscriber list is kept
